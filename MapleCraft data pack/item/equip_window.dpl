	folder cap()
	{
		func add()
		{
			execute unless entity @s[tag=cap_equipped] run data modify storage ui:main equip.cap set value {custom_data:{icon:["",""]},event:{"text":"\uE012","font":"ui:window/equip"}}
			execute if entity @s[tag=cap_equipped] run function ARG(_PATH)set
		}
		
		func set()
		{
			data modify storage ui:main equip.cap set from entity @s equipment.head.components.minecraft:custom_data.cap
			data modify block 250 0 0 front_text.messages[0] set value ["",{"nbt":"equip.cap.minecraft:custom_name","storage":"ui:main","interpret":true}]
			function ARG(_PATH)set_display
			data modify block 250 0 0 front_text.messages[0] set value {"text":"\uE012","font":"ui:window/equip","click_event":{"action":"run_command","command":"/trigger command set 156"},"hover_event":{"action":"show_text","value":{"nbt":"front_text.messages[0]","block":"250 0 0","interpret":true}}}
			data modify storage ui:main equip.cap.event set from block 250 0 0 front_text.messages[0]
		}
		
		func set_display()
		{
			data modify block 250 0 0 front_text.messages[0] set value [{"nbt":"front_text.messages[0]","block":"250 0 0","interpret":true},"\n",{"nbt":"equip.cap.minecraft:lore[0]","storage":"ui:main","interpret":true}]
			data remove storage ui:main equip.cap.minecraft:lore[0]
			execute if data storage ui:main equip.cap.minecraft:lore[0] run function ARG(_PATH)set_display
		}
	
		func take_off()
		{
			execute at @s run playsound minecraft:item.equip player @s
			function item:use/equip/cap/remove
			function item:equip_window/display
		}
	}
	
