		tellraw @s [{"text":"\uE00E","font":"ui:window/equip","shadow_color":0}]
		tellraw @s [{"text":"\uE00F","font":"ui:window/equip","shadow_color":0}]
		
		# tail
		tellraw @s {"text":"\uE010\n\uE011","font":"ui:window/equip","shadow_color":0}
