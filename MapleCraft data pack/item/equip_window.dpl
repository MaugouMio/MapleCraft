namespace equip_window() as virtual
{
	func display()
	{
		# title
		tellraw @s {"text":"\n\n\n\uE000\n\uE001","font":"ui:window/equip","shadow_color":0}
		
		# cap
		function ARG(_PATH)cap/add
		tellraw @s [{"text":"\uF829\uF823","font":"space:default","shadow_color":0},{"nbt":"equip.cap.event","storage":"ui:main","interpret":true},"A3",{"text":"\uE002","font":"ui:window/equip"},"A985",{"nbt":"equip.cap.minecraft:custom_data.icon[0]","storage":"ui:main","interpret":true,"font":"ui:window/equip_back"},{"nbt":"equip.cap.minecraft:custom_data.icon[0]","storage":"ui:main","interpret":true,"font":"ui:window/equip"}]
